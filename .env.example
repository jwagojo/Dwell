# Copy to .env (or .env.local) and fill in real values. Both are git-ignored. Never commit real keys.
# If both files exist, .env.local wins over .env.
# The app runs without any of these: maps and address search fall back to labeled alternatives.

# Mapbox PUBLIC access token (starts with pk.). It ships in the browser bundle, so restrict it by URL.
# Setup steps: docs/mapbox-setup.md. NEVER put a secret token (sk.) here; the app ignores secret tokens.
# Restart `npm run dev` after changing this file.
VITE_MAPBOX_TOKEN=your-mapbox-public-token-here

# EIA Open Data API key (free, register at https://www.eia.gov/opendata/register.php).
# Used for the Massachusetts statewide residential electricity price estimate (see docs/eia-rates.md).
# This is a VITE_ variable, so it is compiled into the browser JavaScript and is visible to anyone who opens the site.
# Do not reuse it anywhere sensitive; EIA keys are free and can be replaced. Never commit the real key.
# Without it the host form uses a labeled $0.30/kWh fallback estimate.
VITE_EIA_API_KEY=your-eia-api-key-here
