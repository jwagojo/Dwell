    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/client-ssm": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@aws-sdk/s3-presigned-post": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/aws-lambda": "8.10.164",
