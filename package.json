{
  "name": "dwell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions && tsc --noEmit -p infra && tsc --noEmit -p scripts",
    "test": "vitest --run",
    "cdk:synth": "cd infra && cdk synth --strict",
    "cdk:diff": "cd infra && cdk diff",
    "cdk:deploy": "cd infra && cdk deploy --all --outputs-file cdk-outputs.json",
    "backend:config": "tsx scripts/write-config.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
